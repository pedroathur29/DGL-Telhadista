{
  "name": "dgl-telhadista",
  "private": true,
  "description": "Site da DGL Telhadista e Serviços em Gerais (telhado em 3D com Three.js e GSAP)",
  "scripts": {
    "build": "npm run build:app && npm run build:scene",
    "build:app": "esbuild js/src/app.js --bundle --format=iife --minify --target=es2019 --outfile=js/app.js",
    "build:scene": "esbuild js/src/scene-entry.js --bundle --format=iife --minify --target=es2019 --loader:.jpg=dataurl --loader:.webp=dataurl --outfile=js/scene.js"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  },
  "dependencies": {
    "gsap": "3.13.0",
    "lenis": "1.1.18",
    "three": "0.170.0"
  }
}
